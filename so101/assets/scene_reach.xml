<!-- SO-101 reach scene: the arm, a floor, and a red target marker the gripper must touch.
     The target is a visual-only site; envs.py moves it each episode. -->
<mujoco model="so101_reach">
  <include file="robotstudio_so101/so101.xml"/>
  <compiler meshdir="robotstudio_so101/assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <site name="target" pos="0.25 0 0.1" size="0.015" rgba="1 0.1 0.1 0.8" group="0"/>
    <body name="workspace_center" pos="0.15 0 0.1"/>
    <camera name="front" pos="0.55 -0.55 0.6" mode="targetbody" target="workspace_center" fovy="60"/>
  </worldbody>
</mujoco>
