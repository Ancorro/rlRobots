<!-- SO-101 tabletop scene: four movable objects of different shapes and three fixed places.
     Objects (so101/tabletop.py places them each episode): red cube, blue ball, yellow cylinder (standing),
     green bar (lying, any heading). Places, fixed like a calibrated real workspace: red tray, blue tray, shelf (6 cm). -->
<mujoco model="so101_tabletop">
  <include file="robotstudio_so101/so101.xml"/>
  <compiler meshdir="robotstudio_so101/assets"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="160" elevation="-20" offwidth="640" offheight="640"/>
  </visual>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <default class="object">
      <geom condim="6" friction="1.5 0.03 0.003" solref="0.01 1" mass="0.02"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="red_cube" pos="0.15 0 0.012">
      <freejoint/>
      <geom name="red_cube" class="object" type="box" size="0.012 0.012 0.012" rgba="0.85 0.1 0.1 1"/>
    </body>
    <body name="blue_ball" pos="0.15 0.05 0.015">
      <freejoint/>
      <geom name="blue_ball" class="object" type="sphere" size="0.015" rgba="0.1 0.3 0.9 1"/>
    </body>
    <body name="yellow_cylinder" pos="0.2 0 0.02">
      <freejoint/>
      <geom name="yellow_cylinder" class="object" type="cylinder" size="0.012 0.02" rgba="0.95 0.8 0.1 1"/>
    </body>
    <body name="green_bar" pos="0.2 0.05 0.01">
      <freejoint/>
      <geom name="green_bar" class="object" type="box" size="0.04 0.01 0.01" rgba="0.1 0.7 0.2 1"/>
    </body>
    <body name="red_tray" pos="0.14 0.17 0.002">
      <geom name="red_tray" type="box" size="0.04 0.04 0.002" rgba="0.95 0.6 0.6 1" contype="0" conaffinity="0"/>
    </body>
    <body name="blue_tray" pos="0.14 -0.17 0.002">
      <geom name="blue_tray" type="box" size="0.04 0.04 0.002" rgba="0.6 0.7 0.95 1" contype="0" conaffinity="0"/>
    </body>
    <body name="shelf" pos="0.31 0 0.03">
      <geom name="shelf" type="box" size="0.035 0.05 0.03" rgba="0.75 0.65 0.5 1"/>
    </body>
    <body name="workspace_center" pos="0.17 0 0.05"/>
    <camera name="front" pos="0.5 -0.3 0.35" mode="targetbody" target="workspace_center" fovy="60"/>
  </worldbody>
</mujoco>
